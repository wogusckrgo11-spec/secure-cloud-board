# 이 파일(.env.example)만 저장소에 커밋한다.
# 실제 값을 채운 사본을 운영 서버의 /etc/board/.env 로 배치하고 권한을 600 으로 설정한다:
#   sudo install -o root -g board -m 600 .env /etc/board/.env
# 실제 .env 는 절대 커밋하지 않는다(.gitignore 에 포함).

# --- DB 서버(프라이빗 서브넷) 접속 정보 ---
DB_HOST=10.0.2.20
DB_PORT=3306
DB_USER=board_app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=board

# --- Flask 세션 서명 키 (flash 메시지에 사용) ---
# 임의의 긴 랜덤 문자열을 생성해 넣는다:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- 선택: 목록 페이지당 글 수 ---
PAGE_SIZE=10
